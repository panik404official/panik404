# Pooled Neon connection string (host contains "-pooler"). Never commit the real value.
NEON_DB_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Optional: Neon DIRECT (non-pooler) URL, used only by the `tortoise ... migrate` CLI
NEON_DB_URL_DIRECT=

# Secrets (>= 16 chars). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
IP_HASH_SECRET=

ENVIRONMENT=production
CORS_ORIGINS=http://localhost:5173,https://panik404.com
TRUST_PROXY=true

# Tuning (defaults are fine to start)
DB_POOL_MIN=1
DB_POOL_MAX=10
TRACK_QUEUE_SIZE=20000
TRACK_FLUSH_INTERVAL=1.0
TRACK_FLUSH_BATCH=500
RATE_LIMIT_TRACK_PER_MIN=120
RATE_LIMIT_ORDERS_PER_MIN=20
RATE_LIMIT_INTAKE_PER_15MIN=5
RATE_LIMIT_CONTACT_PER_15MIN=5
RATE_LIMIT_CONSENT_PER_MIN=240

# Outgoing mail for gift / booking requests (Gmail: use a 16-character app password, not your login)
ADMIN_EMAIL=ethancarter.signmakerz@gmail.com
# Optional: where Contact us messages and signed consent PDFs go (both default to ADMIN_EMAIL)
CONTACT_EMAIL=
CONSENT_EMAIL=
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD=your-16-character-google-app-password
MAIL_FROM=your-gmail-address@gmail.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_TLS=True
